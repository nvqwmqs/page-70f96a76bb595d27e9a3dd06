4;list-style: none;display: flex;justify-content: space-between;align-items: center}\nsummary.faq-question::-webkit-details-marker {display: none}\nsummary.faq-question::after {content: \"+\";font-size: 16px;color: #529E7A;font-weight: 700}\ndetails[open] summary.faq-question::after {content: \"–\"}\n.faq-answer {margin-top: 14px;font-size: 13.5px;line-height: 1.7;color: #4D3F35}\nfooter.site-footer {border-top: 1px solid rgba(45, 35, 27, 0.08);padding: 32px 24px;font-size: 12px;color: #8C7B70;text-align: center}\n@media (max-width: 640px) {\n  header.site-nav {padding: 0 16px}\n  main {padding: 36px 16px 80px}\n  h1.hero-title {font-size: 26px}\n  .plan-item {padding: 24px 20px}\n  .plan-spec-list {grid-template-columns: 1fr;gap: 8px}\n  .guide-container {padding: 24px 20px}\n}\n</style><header class=\"site-nav\">\n  <a href=\"#\" class=\"nav-brand\">8U</a>\n  <nav class=\"nav-links\">\n    <a href=\"#overview\">叙述</a>\n    <a href=\"#plans\">订阅选项</a>\n    <a href=\"#guide\">配置流程</a>\n    <a href=\"#faq\">常见问题</a>\n  </nav>\n</header>\n\n<main>\n  <article class=\"essay-hero\" id=\"overview\">\n    <span class=\"meta-tag\">文档编号 8628 · 基础说明</span>\n    <h1 class=\"hero-title\">8U 分布式节点资源与网络连接协议说明</h1>\n    <p class=\"essay-lead\">\n      在分布式通信和跨地域信息交换场景中，单一路由往往因网络自治域策略、物理链路抖动及汇聚层策略限制而产生不可预估的延迟。8U 将节点资源与底层通道进行标准化抽象，向订阅者交付清晰度确定的分流规则与连接凭据。\n    </p>\n    <p class=\"essay-body\">\n      本文档记录 8U 现行服务分级、流量核算基准以及通用客户端接入规范。所有配置参数与套餐范围均以本页公布为准，旨在为个人研究与团队环境提供明确、可复现的技术预期，避免非必要的网络配置开销。\n    </p>\n  </article>\n\n  <section class=\"section-block\" id=\"plans\">\n    <h2 class=\"section-heading\">订阅方案与规格对照</h2>\n    <p class=\"section-intro\">方案按周期性数据限额与并发设备数划分。各级别均遵循统一的数据包调度机制，计费周期按自然月结算。</p>\n    \n    <div class=\"plans-stack\">\n      <div class=\"plan-item\">\n        <div class=\"plan-head\">\n          <div class=\"plan-name\">基础版</div>\n          <div class=\"plan-price-group\">\n            <span class=\"plan-price\">¥15/月</span>\n            <span class=\"plan-annual\">按年付仅需 ¥150/年</span>\n          </div>\n        </div>\n        <ul class=\"plan-spec-list\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"plan-link\">选择基础版订阅 →</a>\n        </div>\n      </div>\n\n      <div class=\"plan-item\">\n        <div class=\"plan-head\">\n          <div>\n            <span class=\"plan-name\">旗舰版</span>\n            <span class=\"plan-tag\">建议规格</span>\n          </div>\n          <div class=\"plan-price-group\">\n            <span class=\"plan-price\">¥35/月</span>\n            <span class=\"plan-annual\">按年付仅需 ¥350/年</span>\n          </div>\n        </div>\n        <ul class=\"plan-spec-list\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"plan-link\">选择旗舰版订阅 →</a>\n        </div>\n      </div>\n\n      <div class=\"plan-item\">\n        <div class=\"plan-head\">\n          <div class=\"plan-name\">团队版</div>\n          <div class=\"plan-price-group\">\n            <span class=\"plan-price\">¥85/月</span>\n            <span class=\"plan-annual\">按年付仅需 ¥850/年</span>\n          </div>\n        </div>\n        <ul class=\"plan-spec-list\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"plan-link\">选择团队版订阅 →</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section-block\" id=\"guide\">\n    <h2 class=\"section-heading\">客户端通用配置规范</h2>\n    <p class=\"section-intro\">8U 支持行业通用协议。请使用符合各操作系统规范的标准客户端，按照以下步骤完成订阅载入与路由定义。</p>\n    \n    <div class=\"guide-container\">\n      <ol class=\"step-sequence\">\n        <li>\n          <h3>获取订阅凭证</h3>\n          确认当前账户的活跃套餐状态，复制后台生成的安全订阅链接或单节点 URI 代码串。凭据包含访问权限哈希，请妥善保管。\n        </li>\n        <li>\n          <h3>载入并同步节点池</h3>\n          在兼容的第三方客户端配置管理器中新建订阅条目，粘贴链接并执行同步操作。客户端将拉取匹配套餐的最新节点与加密套件参数。\n        </li>\n        <li>\n          <h3>规则策略与路由选择</h3>\n          建议选用分流模式（Rule 或 PAC），使局域网通信与境内域名直连解析，仅跨境或特定目标流量定向通过 8U 节点代理。\n        </li>\n      </ol>\n\n      <div class=\"client-note-box\">\n        <h4>关于软件端的中性说明</h4>\n        8U 暂不提供专有预打包安装程序。用户可在 Windows、macOS、iOS、Android 及 Linux 上使用开源或第三方主流代理适配软件导入订阅，配置方式遵循标准协议规范。\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section-block\" id=\"faq\">\n    <h2 class=\"section-heading\">常见问题</h2>\n    <p class=\"section-intro\">关于配额结算、连接异常及并发设备计算的技术性答疑。</p>\n    \n    <div class=\"faq-stack\">\n      <details class=\"faq-item\">\n        <summary class=\"faq-question\">同时在线设备数是如何判定的？</summary>\n        <div class=\"faq-answer\">\n          系统以处于活跃连接会话的独立出口 IP 与设备指纹进行统计划分。当超出方案许可的设备上限时，新发起的连接请求将被阻断，直至既有连接自然释放或手动断开。\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary class=\"faq-question\">每月流量配额用尽后会有什么变化？</summary>\n        <div class=\"faq-answer\">\n          当月度传输量达到对应规格上限后，节点访问权限将自动暂停，直至下一个自然计费周期开始重置，或通过账户管理面板增购独立附加数据包。\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary class=\"faq-question\">节点延迟与本地网络环境存在何种关联？</summary>\n        <div class=\"faq-answer\">\n          端到端通信性能取决于本地宽带服务商的国际出海通道品质、NAT 类型以及中间路由跳数。建议在网络设置中启用本地 DNS 预解析以减小连接建立阶段的等待时间。\n        </div>\n      </details>\n    </div>\n  </section>\n</main>\n\n<footer class=\"site-footer\">\n  8U 技术文档与接入规范 · 仅供网络协议测试与工程参考\n</footer>",
